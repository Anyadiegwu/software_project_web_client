    e.preventDefault();
    if (loading) return;

    if (!email || !password) {
      setError("Email and password are required");
      return;
    }

    if (!agreed) {
      setError("You must agree to the terms");
      return;
    }

    try {
      setLoading(true);
      setError('');

      const payload = {
        name: displayName || "Anonymous",
        email,
        password,
      };

      const res = await authService.register("reporter", payload);
      console.log("FULL RESPONSE:", res);
      setDisplayName('');

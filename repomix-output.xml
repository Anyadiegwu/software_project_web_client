<file path="src/pages/officerPages/OfficerDashboard.module.css">
/* ============================================================ WRAPPER */
.wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  /* background: #0a0f1a; */
  background: var(--color-blue-897, #0A0F1EF7);
  font-family: 'DM Sans', system-ui, sans-serif;
}

/* ============================================================ TOP BAR */
.topBar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28px;
  height: 56px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  flex-shrink: 0;
  /* background: #0a0f1a; */
  background: var(--color-blue-897, #0A0F1EF7);
}

.breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
}

.breadcrumbParent {
  font-size: 12px;
  color: #6b7280;
  font-family: 'DM Sans', system-ui, sans-serif;
}

.breadcrumbSep {
  font-size: 12px;
  color: #374151;
}

.breadcrumbCurrent {
  font-size: 12px;
  font-weight: 600;
  color: #e5e7eb;
}

.topRight {
  display: flex;
  align-items: center;
  gap: 10px;
}

.searchBox {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 8px;
  padding: 7px 14px;
  width: 220px;
  transition: border-color 0.2s;
}

.searchBox:focus-within {
  border-color: rgba(59, 130, 246, 0.4);
}

.searchInput {
  background: transparent;
  border: none;
  outline: none;
  font-size: 12px;
  color: #e5e7eb;
  font-family: 'DM Sans', system-ui, sans-serif;
  width: 100%;
}

.searchInput::placeholder {
  color: #4b5563;
}

.iconBtn {
  width: 34px;
  height: 34px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  position: relative;
  transition: background 0.2s;
}

.iconBtn:hover {
  background: rgba(255, 255, 255, 0.08);
}

.iconBtnDot {
  position: absolute;
  top: 7px;
  right: 7px;
  width: 6px;
  height: 6px;
  background: var(--color-red-60, #EF4444);
  border-radius: 50%;
  border: 1.5px solid #0a0f1a;
}

.avatarBtn {
  width: 34px;
  height: 34px;
  background: #3b82f6;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 15px;
  font-weight: 700;
  color: #fff;
  cursor: pointer;
  flex-shrink: 0;
}

/* ============================================================ BODY */
.body {
  flex: 1;
  overflow-y: auto;
  padding: 28px 28px 40px;
  display: flex;
  flex-direction: column;
  gap: 24px;

  scrollbar-width: none;
  -ms-overflow-style: none;
}

.body::-webkit-scrollbar {
  display: none;
}

/* ============================================================ GREETING */
.greeting {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.greetingMeta {
  display: flex;
  align-items: center;
  gap: 8px;
}

.greetingDate {
  font-family: 'DM Mono', monospace;
  font-size: 10.5px;
  font-weight: 500;
  color: var(--color-azure-60, #3B82F6);
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.greetingDot {
  color: var(--color-azure-60, #3B82F6);
  font-size: 12px;
}

.greetingShift {
  font-family: 'DM Mono', monospace;
  font-size: 10.5px;
  font-weight: 500;
  color: var(--color-azure-60, #3B82F6);
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.greetingTitle {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(26px, 3vw, 38px);
  font-weight: 800;
  color: #f9fafb;
  line-height: 1.15;
  margin: 0;
  letter-spacing: -0.5px;
}

.greetingSubtitle {
  font-size: 12.5px;
  color: #6b7280;
  margin: 0;
  letter-spacing: 0.2px;
}

/* ============================================================ COMMAND BANNER */
.commandBanner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  background: rgba(59, 130, 246, 0.05);
  border: 1px solid rgba(59, 130, 246, 0.15);
  border-radius: 10px;
  padding: 24px 28px;
}

.commandBannerLeft {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.commandBannerTag {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  font-weight: 500;
  color: var(--color-azure-60, #3B82F6);
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.commandBannerTagDot {
  color: #374151;
}

.commandBannerTitle {

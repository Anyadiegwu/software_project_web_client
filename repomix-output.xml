  font-family: DM Sans;
  font-weight: 500;
  font-style: Medium;
  font-size: 12.2px;
  line-height: 17.63px;
  letter-spacing: 0%;
  vertical-align: middle;
  }

.benefitDesc {
  color: var(--color-azure-65, #9CA3AF);
  font-family: DM Sans;
  font-weight: 400;
  font-style: Regular;
  font-size: 11.7px;
  line-height: 16.94px;
  letter-spacing: 0%;

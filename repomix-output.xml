<file path="src/pages/RoleSelect.module.css">
.container {
  position: relative;
  min-height: 100vh;
  padding: 80px 20px; /* ⬅️ adds space top & bottom */

  background: radial-gradient(circle at top, #0d1b2a, #020617);
  color: #e5e7eb;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  font-family: "Inter", sans-serif;
}
/* Close button */
.closeBtn {
  text-decoration: none;
  position: absolute;
  top: 20px;
  right: 20px;
  background: #0f172a;
  border: none;
  color: #94a3b8;
  font-size: 20px;
  width: 40px;
  height: 40px;
  border-radius: 8px;
  cursor: pointer;
}

/* Header */
.header {
  text-align: center;
  max-width: 600px;
  margin-bottom: 40px;
}

.header h1 {
  font-size: 36px;

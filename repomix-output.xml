}

.header h1 span {
  color: #14b8a6;
}

.header p {
  margin-top: 10px;
  color: #94a3b8;
  font-size: 14px;
  line-height: 1.6;
}

/* Cards wrapper */
.cardWrapper {
  display: flex;
  gap: 30px;
  margin-bottom: 30px;
}
.cardWrapper a {
  text-decoration: none;
}   
/* Card */
.card {
  width: 420px;
  padding: 30px;
  border-radius: 16px;
  background: linear-gradient(145deg, #0f172a, #020617);
  border: 1px solid #1e293b;
  transition: 0.3s ease;
}

/* Left card glow */
.leftCard {
  border: 1px solid rgba(20, 184, 166, 0.4);
  box-shadow: 0 0 40px rgba(20, 184, 166, 0.15);
}

/* Right card */
.rightCard {
  border: 1px solid rgba(59, 130, 246, 0.3);
}

/* Icon box */
.iconBox {
  width: 50px;
  height: 50px;
  border-radius: 12px;
  background: #0f172a;
  display: flex;
  align-items: center;
  justify-content: center;
  color: orange;
  font-size: 20px;
  margin-bottom: 20px;
}

/* Role tag */
.roleTag {
  color: #14b8a6;
  font-size: 12px;
  letter-spacing: 2px;
  margin-bottom: 10px;
}

.roleTagBlue {
  color: #3b82f6;
  font-size: 12px;
  letter-spacing: 2px;
  margin-bottom: 10px;
}

/* Titles */
.card h2 {
  font-size: 22px;
  margin-bottom: 10px;
}

/* Description */
.description {
  font-size: 14px;
  color: #94a3b8;
  line-height: 1.6;
  margin-bottom: 25px;
}

/* Buttons */
.primaryBtn {
  background: none;
  border: none;
  color: #14b8a6;
  font-size: 14px;
  cursor: pointer;
}

.secondaryBtn {
  background: none;
  border: none;
  color: #3b82f6;
  font-size: 14px;
  cursor: pointer;
}

/* Footer */
.footer {
  font-size: 14px;
  color: #94a3b8;
}

.footer span {
  color: #14b8a6;
  cursor: pointer;
}

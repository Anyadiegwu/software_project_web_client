  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: 6px;
}

/* ============================================================ CTA */
.cta {
  padding: 100px 60px;
  text-align: center;
  background: linear-gradient(180deg, #0a0f0e 0%, #0d1714 50%, #0a0f0e 100%);
  position: relative;
}

.cta::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, rgba(0, 229, 204, 0.05) 0%, transparent 70%);
  pointer-events: none;
}

.ctaTitle {
  font-size: 36px;
  font-weight: 800;
  color: var(--text-primary);
  margin: 0 0 16px;
  letter-spacing: -0.3px;
  position: relative;
}

.ctaDesc {
  font-size: 14px;
  color: var(--text-secondary);
  max-width: 480px;
  margin: 0 auto 36px;
  line-height: 1.7;
  position: relative;
}

.ctaActions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  position: relative;
}

.btnOutline {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--text-secondary);
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
  border: 1px solid var(--border-subtle);
  padding: 11px 20px;
  border-radius: 3px;
  transition: border-color 0.2s, color 0.2s;
}

.btnOutline:hover {
  border-color: var(--accent);
  color: var(--accent);
}

/* ============================================================ FOOTER */
.footer {
  padding: 24px 60px;
  border-top: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
}

/* ============================================================ RESPONSIVE */
@media (max-width: 1024px) {
  .hero {
    padding: 40px 32px 50px;
  }

  .heroTitle {
    font-size: 34px;
  }

  .twoRoles,
  .vicious,
  .threeApps,
  .fourLayers,
  .whyAegis,
  .roadmap,
  .revenue,
  .appDownload {
    padding: 50px 32px;
  }

  .appsGrid,
  .whyGrid,
  .roadmapGrid {
    grid-template-columns: 1fr 1fr;
  }

  .fourLayers {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .revenue {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .appDownload {
    grid-template-columns: 1fr;
  }

  .cta {
    padding: 70px 32px;
  }
}

@media (max-width: 768px) {
  .navbar {
    padding: 0 20px;
  }


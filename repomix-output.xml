.officerMainWrapper {
  display: flex;
  height: 100vh;
  width: 100vw;
  overflow: hidden;
  background: #0a0f1e;
}

.officerSidebar {
  width: 260px;
  flex-shrink: 0;
  height: 100vh;
  overflow-y: auto;
  overflow-x: hidden;
  position: sticky;
  top: 0;
  left: 0;
}

.mainContent {
  flex: 1;
  height: 100vh;
  overflow-y: auto;
  overflow-x: hidden;
  min-width: 0;
}

/* ── Overlay (mobile/tablet) ── */
.overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 99;
  backdrop-filter: blur(2px);
}

.overlayVisible {
  display: block;
}

@media (max-width: 768px) {
  .officerSidebar {
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    width: 240px;
    z-index: 100;
    transform: translateX(-100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .officerSidebarOpen {
    transform: translateX(0);
  }

  .mainContent {
    width: 100%;
  }
}

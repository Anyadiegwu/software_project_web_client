// ── Helper: derive initials from officer object ──
const getInitials = (officer) => {
  if (!officer) return "?";
  if (officer.initials) return officer.initials;
  const name = officer.name || officer.fullName || "";
  const parts = name.trim().split(" ");
  if (parts.length >= 2) return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
  if (parts[0]) return parts[0][0].toUpperCase();
  return "?";
};

// ── Helper: derive display name ──
const getDisplayName = (officer) => {
  if (!officer) return "Officer";
  return officer.name || officer.fullName || `${officer.firstName || ""} ${officer.lastName || ""}`.trim() || "Officer";
};

export default function OfficerSidebar({ activeId, onNavigate, officer, onSignOut }) {
  const [active, setActive] = useState(activeId || "dashboard");

  const handleNav = (id) => {
    setActive(id);
    if (onNavigate) onNavigate(id);
  };

  const handleSignOut = () => {
    if (onSignOut) {
      // Use the parent's sign-out handler (already has confirm logic in OfficerMain)
      onSignOut();
    } else if (window.confirm("Are you sure you want to sign out?")) {
      window.location.href = "/officer/sign-in";
    }
  };

  const initials = getInitials(officer);
  const displayName = getDisplayName(officer);
  const badgeNumber = officer?.badgeNumber || officer?.badge || "NPF-2024-001";

  return (
    <aside className={styles.sidebar}>

      {/* ── Brand ── */}
      <div className={styles.brand}>
        <div className={styles.brandLogo}>
          <svg width="22" height="22" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="40" height="40" rx="6" fill="#00D4AA"/>
            <path d="M21.2 13.23L26.79 27.66C27.01 28.18 27.24 28.56 27.49 28.79C27.73 29.01 27.96 29.12 28.16 29.14V29.6C27.6 29.57 26.95 29.55 26.21 29.55C25.47 29.54 24.72 29.53 23.95 29.53C23.16 29.53 22.42 29.54 21.73 29.55C21.04 29.55 20.48 29.57 20.06 29.6V29.14C20.85 29.11 21.34 28.98 21.54 28.74C21.76 28.5 21.71 27.98 21.41 27.2L17.71 16.95L18.17 16.15L14.98 24.44C14.59 25.45 14.35 26.26 14.26 26.87C14.19 27.47 14.22 27.94 14.38 28.26C14.53 28.58 14.78 28.81 15.12 28.93C15.46 29.05 15.86 29.12 16.32 29.14V29.6C15.75 29.57 15.23 29.55 14.77 29.55C14.32 29.54 13.83 29.53 13.29 29.53C13 29.53 12.68 29.54 12.34 29.55C12.02 29.55 11.74 29.57 11.51 29.6V29.14C11.87 29.08 12.21 28.85 12.55 28.47C12.91 28.07 13.27 27.39 13.64 26.43L18.77 13.23C19.14 13.26 19.54 13.28 19.97 13.28C20.42 13.28 20.83 13.26 21.2 13.23ZM22.01 22.94V23.4H15.12L15.35 22.94H22.01Z" fill="#0A0F1E"/>
          </svg>
        </div>
        <div className={styles.brandInfo}>
          <span className={styles.brandName}>AEGIS</span>
          <span className={styles.brandSub}>Command Platform</span>
        </div>
      </div>

      {/* ── Officer Profile ── */}
      <div className={styles.profile}>
        <div className={styles.profileAvatar}>
          <span>{initials}</span>
        </div>
        <div className={styles.profileInfo}>
          <span className={styles.profileName}>{displayName}</span>
          <span className={styles.profileRole}>
            {officer?.role || officer?.rank || "SECURITY PERSONNEL"}
          </span>
        </div>
      </div>

      <div className={styles.divider} />

      {/* ── Navigation ── */}
      <nav className={styles.nav}>
        {navSections.map((section) => (
          <div key={section.label} className={styles.navSection}>
            <span className={styles.navSectionLabel}>{section.label}</span>
            {section.items.map((item) => (
              <button
                key={item.id}
                className={`${styles.navItem} ${active === item.id ? styles.navItemActive : ""}`}
                onClick={() => handleNav(item.id)}
              >
                <span className={styles.navIcon}>{item.icon}</span>
                <span className={styles.navLabel}>{item.label}</span>
                {item.badge && (
                  <span className={`${styles.badge} ${item.badgeColor === "amber" ? styles.badgeAmber : styles.badgeRed}`}>
                    {item.badge}
                  </span>
                )}
              </button>
            ))}
          </div>
        ))}
      </nav>

      {/* ── Sign Out ── */}
      <div className={styles.footer}>
        <button className={styles.signOut} onClick={handleSignOut}>
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M8.57129 0.321411H10.8213C11.6497 0.321411 12.3213 0.992984 12.3213 1.82141V10.8214C12.3213 11.6499 11.6497 12.3214 10.8213 12.3214H8.57129" stroke="#F59E0B" strokeWidth="0.642857" strokeLinecap="round" strokeLinejoin="round"/>
          <path d="M3.32129 3.32141L0.321289 6.32141L3.32129 9.32141" stroke="#F59E0B" strokeWidth="0.642857" strokeLinecap="round" strokeLinejoin="round"/>
          <path d="M0.321289 6.32141H9.32129" stroke="#F59E0B" strokeWidth="0.642857" strokeLinecap="round" strokeLinejoin="round"/>
          </svg>
          <span>Sign Out</span>
        </button>
        <span className={styles.footerVersion}>
          Aegis Web v1.0.0 · Badge: {badgeNumber}
        </span>
      </div>

    </aside>
  );
}

  font-family: DM Mono;
  font-weight: 400;
  font-style: Regular;
  font-size: 9.9px;
  line-height: 100%;
  letter-spacing: 1.98px;
  vertical-align: middle;
  text-transform: uppercase;
}

.title {
  font-family: Playfair Display;
  font-weight: 900;
  font-style: Black;
  font-size: 36.8px;
  line-height: 41.22px;
  letter-spacing: 0%;
  vertical-align: middle;
  margin: 0 0 20px;
  color: var(--color-grey-98, #F9FAFB);
  letter-spacing: -0.5px;
  max-width: 300px;
}

.highlight {
  color:  var(--color-cyan-42, #00D4AA);
}

.subtitle {
  font-family: DM Sans;
  font-weight: 400;
  font-style: Regular;
  font-size: 13.4px;
  line-height: 22.85px;
  letter-spacing: 0%;
  vertical-align: middle;

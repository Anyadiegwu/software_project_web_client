.formFooter {
  text-align: center;
  margin-top: 20px;
  color: var(--color-grey-46, #6B7280);
  font-family: "DM Sans", sans-serif;
  font-size: 11.8px;
}
.createLink {
  text-decoration: none;
  color: var(--color-cyan-42, #00D4AA);
}
.createLink:hover { text-decoration: underline; }

/* ──────────────────────────────────────────
   TABLET (≤ 1024px) — hide left panel
────────────────────────────────────────── */
@media (max-width: 1024px) {
  /* Hide the role select panel entirely */
  .panel {
    display: none;
  }

  /* Form section takes full width */
  .formSection {
    padding: 48px 40px;
    align-items: flex-start;
  }

  /* Navbar adjustments */
  .navbar {
    padding: 14px 24px;
  }
}

/* ──────────────────────────────────────────
   MOBILE (≤ 640px)
────────────────────────────────────────── */
@media (max-width: 640px) {
  .navbar {
    padding: 12px 16px;
    gap: 8px;
  }

  /* Hide "back to role select" text on very small screens — too long */
  .navCenter {
    font-size: 10px;
    letter-spacing: 0.4px;
  }

  .logo span {
    font-size: 11px;
    letter-spacing: 1.5px;
  }

  .formSection {
    padding: 32px 20px 48px;
  }

  .mainTitle {
    font-size: 22px;
    line-height: 28px;
  }

  .formActions {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .alertBox {
    flex-direction: column;
    gap: 8px;
  }
}

/* ──────────────────────────────────────────
   VERY SMALL (≤ 380px)
────────────────────────────────────────── */
@media (max-width: 380px) {
  .navCenter {
    display: none;
  }

  .formSection {
    padding: 24px 16px 40px;
  }
}

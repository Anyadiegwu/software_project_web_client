/* ============================================================ ROOT */
.container {
  min-height: 100vh;
  background: var(--color-blue-8, rgba(10, 15, 30, 1));
  color: #e5e7eb;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 40px;
  border-bottom: 1px solid #0f172a;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
}


.logoText {
  color: #14b8a6;
  letter-spacing: 2px;
  font-family: DM Mono;
  font-weight: font weight/400;
  font-style: Regular;
  font-size: 13.6px;
  line-height: line height/22_44;
  letter-spacing: letter spacing/2_04;
  vertical-align: middle;
  text-transform: uppercase;
}
.backLink {
  text-decoration: none;
  color: var(--color-grey-46, #6B7280);
  font-size: 12px;
  font-family: DM Sans;
  font-weight: 400;
  font-style: Regular;
  font-size: 12px;
  line-height: 100%;
  letter-spacing: 0.72px;
  vertical-align: middle;
  text-transform: uppercase;

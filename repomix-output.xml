                    {' '}and{' '}
                    <a href="#" className={styles.link}>Privacy Policy</a>.
                    {' '}I understand my data is protected and never shared with authorities without my consent.
                  </span>
                </label>
              </div>

              {/* Submit */}
              <button
                type="submit"
                className={styles.createButton}
                disabled={loading}
              >
                {loading ? "CREATING..." : "CREATE ACCOUNT"}
              </button>

              <p className={styles.signInLink}>
                Already have an account?{' '}
                <Link className={styles.link} to="/sign-in" state={{ role: "reporter" }}>
                  Sign in
                </Link>
              </p>

            </form>
          </div>
        </div>
      </div>
    </div>
  );
};

export default CreateAccount;
</file>

